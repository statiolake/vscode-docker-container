{
  "name": "vscode-docker-container",
  "displayName": "Docker Container Stacks",
  "description": "Manage Docker Compose stacks and containers from the VS Code UI side.",
  "version": "0.1.3",
  "publisher": "statiolake",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/statiolake/vscode-docker-container.git"
  },
  "bugs": {
    "url": "https://github.com/statiolake/vscode-docker-container/issues"
  },
  "homepage": "https://github.com/statiolake/vscode-docker-container#readme",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onView:dockerContainerStacksRunning",
    "onView:dockerContainerStacksInactive",
    "onCommand:dockerContainerStacks.refresh",
    "onCommand:dockerContainerStacks.stack.copyName",
    "onCommand:dockerContainerStacks.stack.rebuild",
    "onCommand:dockerContainerStacks.stack.down",
    "onCommand:dockerContainerStacks.stack.downVolumes",
    "onCommand:dockerContainerStacks.container.copyName",
    "onCommand:dockerContainerStacks.container.executeBash",
    "onCommand:dockerContainerStacks.container.rebuild",
    "onCommand:dockerContainerStacks.container.remove",
    "onCommand:dockerContainerStacks.openLogs"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dockerContainerStacks.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "dockerContainerStacks.stack.stop",
        "title": "Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dockerContainerStacks.stack.start",
        "title": "Start",
        "icon": "$(debug-start)"
      },
      {
        "command": "dockerContainerStacks.stack.rebuild",
        "title": "Rebuild",
        "icon": "$(tools)"
      },
      {
        "command": "dockerContainerStacks.stack.rebuildUnavailable",
        "title": "Rebuild (compose file not found)",
        "enablement": "false",
        "icon": "$(warning)"
      },
      {
        "command": "dockerContainerStacks.stack.down",
        "title": "Down",
        "icon": "$(trash)"
      },
      {
        "command": "dockerContainerStacks.stack.downVolumes",
        "title": "Down -v",
        "icon": "$(trash)"
      },
      {
        "command": "dockerContainerStacks.stack.copyName",
        "title": "Copy name",
        "icon": "$(copy)"
      },
      {
        "command": "dockerContainerStacks.container.stop",
        "title": "Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dockerContainerStacks.container.start",
        "title": "Start",
        "icon": "$(debug-start)"
      },
      {
        "command": "dockerContainerStacks.container.restart",
        "title": "Restart",
        "icon": "$(sync)"
      },
      {
        "command": "dockerContainerStacks.container.rebuild",
        "title": "Rebuild",
        "icon": "$(tools)"
      },
      {
        "command": "dockerContainerStacks.container.rebuildUnavailable",
        "title": "Rebuild (compose file not found)",
        "enablement": "false",
        "icon": "$(warning)"
      },
      {
        "command": "dockerContainerStacks.container.remove",
        "title": "Remove",
        "icon": "$(trash)"
      },
      {
        "command": "dockerContainerStacks.container.copyName",
        "title": "Copy name",
        "icon": "$(copy)"
      },
      {
        "command": "dockerContainerStacks.container.executeBash",
        "title": "Execute Bash",
        "icon": "$(terminal)"
      },
      {
        "command": "dockerContainerStacks.openLogs",
        "title": "Open Logs",
        "icon": "$(output)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dockerContainerStacksPanel",
          "title": "Docker Containers",
          "icon": "media/container.svg"
        }
      ]
    },
    "views": {
      "dockerContainerStacksPanel": [
        {
          "id": "dockerContainerStacksRunning",
          "name": "Running"
        },
        {
          "id": "dockerContainerStacksInactive",
          "name": "Exited / Created"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dockerContainerStacks.refresh",
          "when": "view == dockerContainerStacksRunning",
          "group": "navigation"
        },
        {
          "command": "dockerContainerStacks.refresh",
          "when": "view == dockerContainerStacksInactive",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dockerContainerStacks.stack.stop",
          "when": "view == dockerContainerStacksRunning && viewItem =~ /^(composeStackBuildable|composeStack|standaloneStack)\\.running$/",
          "group": "1_stack@1"
        },
        {
          "command": "dockerContainerStacks.stack.start",
          "when": "view == dockerContainerStacksInactive && viewItem =~ /^(composeStackBuildable|composeStack|standaloneStack)\\.inactive$/",
          "group": "1_stack@1"
        },
        {
          "command": "dockerContainerStacks.stack.rebuild",
          "when": "view == dockerContainerStacksRunning && viewItem =~ /^composeStackBuildable\\.running$/",
          "group": "1_stack@2"
        },
        {
          "command": "dockerContainerStacks.stack.rebuildUnavailable",
          "when": "view == dockerContainerStacksRunning && viewItem =~ /^composeStack\\.running$/",
          "group": "1_stack@2"
        },
        {
          "command": "dockerContainerStacks.stack.rebuild",
          "when": "view == dockerContainerStacksInactive && viewItem =~ /^composeStackBuildable\\.inactive$/",
          "group": "1_stack@2"
        },
        {
          "command": "dockerContainerStacks.stack.rebuildUnavailable",
          "when": "view == dockerContainerStacksInactive && viewItem =~ /^composeStack\\.inactive$/",
          "group": "1_stack@2"
        },
        {
          "command": "dockerContainerStacks.stack.down",
          "when": "viewItem =~ /^(composeStackBuildable|composeStack)\\.(running|inactive)$/",
          "group": "1_stack@3"
        },
        {
          "command": "dockerContainerStacks.stack.downVolumes",
          "when": "viewItem =~ /^(composeStackBuildable|composeStack)\\.(running|inactive)$/",
          "group": "1_stack@4"
        },
        {
          "command": "dockerContainerStacks.stack.copyName",
          "when": "viewItem =~ /^(composeStackBuildable|composeStack|standaloneStack)\\.(running|inactive)$/",
          "group": "2_utility@1"
        },
        {
          "command": "dockerContainerStacks.container.stop",
          "when": "view == dockerContainerStacksRunning && viewItem =~ /^(composeContainerBuildable|composeContainer|dockerContainer)\\.running$/",
          "group": "1_container@1"
        },
        {
          "command": "dockerContainerStacks.container.restart",
          "when": "view == dockerContainerStacksRunning && viewItem =~ /^(composeContainerBuildable|composeContainer|dockerContainer)\\.running$/",
          "group": "inline@1"
        },
        {
          "command": "dockerContainerStacks.container.restart",
          "when": "view == dockerContainerStacksRunning && viewItem =~ /^(composeContainerBuildable|composeContainer|dockerContainer)\\.running$/",
          "group": "1_container@2"
        },
        {
          "command": "dockerContainerStacks.container.rebuild",
          "when": "view == dockerContainerStacksRunning && viewItem =~ /^composeContainerBuildable\\.running$/",
          "group": "1_container@3"
        },
        {
          "command": "dockerContainerStacks.container.rebuildUnavailable",
          "when": "view == dockerContainerStacksRunning && viewItem =~ /^composeContainer\\.running$/",
          "group": "1_container@3"
        },
        {
          "command": "dockerContainerStacks.container.start",
          "when": "view == dockerContainerStacksInactive && viewItem =~ /^(composeContainerBuildable|composeContainer|dockerContainer)\\.inactive$/",
          "group": "1_container@1"
        },
        {
          "command": "dockerContainerStacks.container.restart",
          "when": "view == dockerContainerStacksInactive && viewItem =~ /^(composeContainerBuildable|composeContainer|dockerContainer)\\.inactive$/",
          "group": "inline@1"
        },
        {
          "command": "dockerContainerStacks.container.restart",
          "when": "view == dockerContainerStacksInactive && viewItem =~ /^(composeContainerBuildable|composeContainer|dockerContainer)\\.inactive$/",
          "group": "1_container@2"
        },
        {
          "command": "dockerContainerStacks.container.rebuild",
          "when": "view == dockerContainerStacksInactive && viewItem =~ /^composeContainerBuildable\\.inactive$/",
          "group": "1_container@3"
        },
        {
          "command": "dockerContainerStacks.container.rebuildUnavailable",
          "when": "view == dockerContainerStacksInactive && viewItem =~ /^composeContainer\\.inactive$/",
          "group": "1_container@3"
        },
        {
          "command": "dockerContainerStacks.container.remove",
          "when": "view == dockerContainerStacksInactive && viewItem =~ /^(composeContainerBuildable|composeContainer|dockerContainer)\\.inactive$/",
          "group": "1_container@4"
        },
        {
          "command": "dockerContainerStacks.container.copyName",
          "when": "viewItem =~ /^(composeContainerBuildable|composeContainer|dockerContainer)\\.(running|inactive)$/",
          "group": "2_utility@1"
        },
        {
          "command": "dockerContainerStacks.container.executeBash",
          "when": "view == dockerContainerStacksRunning && viewItem =~ /^(composeContainerBuildable|composeContainer|dockerContainer)\\.running$/",
          "group": "2_utility@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dockerContainerStacks.stack.stop",
          "when": "false"
        },
        {
          "command": "dockerContainerStacks.stack.copyName",
          "when": "false"
        },
        {
          "command": "dockerContainerStacks.stack.start",
          "when": "false"
        },
        {
          "command": "dockerContainerStacks.stack.rebuild",
          "when": "false"
        },
        {
          "command": "dockerContainerStacks.stack.rebuildUnavailable",
          "when": "false"
        },
        {
          "command": "dockerContainerStacks.stack.down",
          "when": "false"
        },
        {
          "command": "dockerContainerStacks.stack.downVolumes",
          "when": "false"
        },
        {
          "command": "dockerContainerStacks.container.stop",
          "when": "false"
        },
        {
          "command": "dockerContainerStacks.container.copyName",
          "when": "false"
        },
        {
          "command": "dockerContainerStacks.container.executeBash",
          "when": "false"
        },
        {
          "command": "dockerContainerStacks.container.start",
          "when": "false"
        },
        {
          "command": "dockerContainerStacks.container.restart",
          "when": "false"
        },
        {
          "command": "dockerContainerStacks.container.rebuild",
          "when": "false"
        },
        {
          "command": "dockerContainerStacks.container.rebuildUnavailable",
          "when": "false"
        },
        {
          "command": "dockerContainerStacks.container.remove",
          "when": "false"
        },
        {
          "command": "dockerContainerStacks.openLogs",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Docker Container Stacks",
      "properties": {
        "dockerContainerStacks.dockerPath": {
          "type": "string",
          "default": "docker",
          "description": "Path to the Docker CLI used by this UI extension."
        },
        "dockerContainerStacks.logTail": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "description": "Number of log lines to load when opening a container log editor. Set to 0 for all logs."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "package": "vsce package",
    "publish": "vsce publish",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^6.0.0"
  }
}
